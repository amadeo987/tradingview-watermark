// [ad] Watermark v1.2
// Fixed text watermark for chart screenshots (e.g. a social media handle or a short tagline).
// The text is anchored to the screen and shows on every symbol and timeframe.

//@version=6
indicator("[ad] Watermark v1.2", shorttitle = "Watermark", overlay = true)

// ==================== CONSTANTS ====================
// Font names are written in their own style so the dropdown previews the look.
const string FONT_SYSTEM = "System"
const string FONT_MONO = "Monospace"
const string FONT_SERIF = "𝐒𝐞𝐫𝐢𝐟"
const string FONT_SERIF_ITALIC = "𝑺𝒆𝒓𝒊𝒇 𝑰𝒕𝒂𝒍𝒊𝒄"
const string FONT_SANS = "𝗦𝗮𝗻𝘀"
const string FONT_SANS_ITALIC = "𝙎𝙖𝙣𝙨 𝙄𝙩𝙖𝙡𝙞𝙘"
const string FONT_SCRIPT = "𝓢𝓬𝓻𝓲𝓹𝓽"
const string FONT_FRAKTUR = "𝕱𝖗𝖆𝖐𝖙𝖚𝖗"
const string FONT_DOUBLE_STRUCK = "𝔻𝕠𝕦𝕓𝕝𝕖-𝕤𝕥𝕣𝕦𝕔𝕜"

const string LINE_NONE = "None"
const string LINE_UNDERLINE = "Underline"
const string LINE_STRIKETHROUGH = "Strikethrough"

const string POS_TOP_CENTER = "Top center"
const string POS_TOP_LEFT = "Top left"
const string POS_TOP_RIGHT = "Top right"
const string POS_MIDDLE = "Middle center"
const string POS_BOTTOM_CENTER = "Bottom center"
const string POS_BOTTOM_LEFT = "Bottom left"
const string POS_BOTTOM_RIGHT = "Bottom right"

// Letters and digits in the same order as the style maps below.
const string PLAIN_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
const string MAP_SERIF = "𝐀 𝐁 𝐂 𝐃 𝐄 𝐅 𝐆 𝐇 𝐈 𝐉 𝐊 𝐋 𝐌 𝐍 𝐎 𝐏 𝐐 𝐑 𝐒 𝐓 𝐔 𝐕 𝐖 𝐗 𝐘 𝐙 𝐚 𝐛 𝐜 𝐝 𝐞 𝐟 𝐠 𝐡 𝐢 𝐣 𝐤 𝐥 𝐦 𝐧 𝐨 𝐩 𝐪 𝐫 𝐬 𝐭 𝐮 𝐯 𝐰 𝐱 𝐲 𝐳 𝟎 𝟏 𝟐 𝟑 𝟒 𝟓 𝟔 𝟕 𝟖 𝟗"
const string MAP_SERIF_ITALIC = "𝑨 𝑩 𝑪 𝑫 𝑬 𝑭 𝑮 𝑯 𝑰 𝑱 𝑲 𝑳 𝑴 𝑵 𝑶 𝑷 𝑸 𝑹 𝑺 𝑻 𝑼 𝑽 𝑾 𝑿 𝒀 𝒁 𝒂 𝒃 𝒄 𝒅 𝒆 𝒇 𝒈 𝒉 𝒊 𝒋 𝒌 𝒍 𝒎 𝒏 𝒐 𝒑 𝒒 𝒓 𝒔 𝒕 𝒖 𝒗 𝒘 𝒙 𝒚 𝒛 𝟎 𝟏 𝟐 𝟑 𝟒 𝟓 𝟔 𝟕 𝟖 𝟗"
const string MAP_SANS = "𝗔 𝗕 𝗖 𝗗 𝗘 𝗙 𝗚 𝗛 𝗜 𝗝 𝗞 𝗟 𝗠 𝗡 𝗢 𝗣 𝗤 𝗥 𝗦 𝗧 𝗨 𝗩 𝗪 𝗫 𝗬 𝗭 𝗮 𝗯 𝗰 𝗱 𝗲 𝗳 𝗴 𝗵 𝗶 𝗷 𝗸 𝗹 𝗺 𝗻 𝗼 𝗽 𝗾 𝗿 𝘀 𝘁 𝘂 𝘃 𝘄 𝘅 𝘆 𝘇 𝟬 𝟭 𝟮 𝟯 𝟰 𝟱 𝟲 𝟳 𝟴 𝟵"
const string MAP_SANS_ITALIC = "𝘼 𝘽 𝘾 𝘿 𝙀 𝙁 𝙂 𝙃 𝙄 𝙅 𝙆 𝙇 𝙈 𝙉 𝙊 𝙋 𝙌 𝙍 𝙎 𝙏 𝙐 𝙑 𝙒 𝙓 𝙔 𝙕 𝙖 𝙗 𝙘 𝙙 𝙚 𝙛 𝙜 𝙝 𝙞 𝙟 𝙠 𝙡 𝙢 𝙣 𝙤 𝙥 𝙦 𝙧 𝙨 𝙩 𝙪 𝙫 𝙬 𝙭 𝙮 𝙯 𝟬 𝟭 𝟮 𝟯 𝟰 𝟱 𝟲 𝟳 𝟴 𝟵"
const string MAP_SCRIPT = "𝓐 𝓑 𝓒 𝓓 𝓔 𝓕 𝓖 𝓗 𝓘 𝓙 𝓚 𝓛 𝓜 𝓝 𝓞 𝓟 𝓠 𝓡 𝓢 𝓣 𝓤 𝓥 𝓦 𝓧 𝓨 𝓩 𝓪 𝓫 𝓬 𝓭 𝓮 𝓯 𝓰 𝓱 𝓲 𝓳 𝓴 𝓵 𝓶 𝓷 𝓸 𝓹 𝓺 𝓻 𝓼 𝓽 𝓾 𝓿 𝔀 𝔁 𝔂 𝔃 𝟎 𝟏 𝟐 𝟑 𝟒 𝟓 𝟔 𝟕 𝟖 𝟗"
const string MAP_FRAKTUR = "𝕬 𝕭 𝕮 𝕯 𝕰 𝕱 𝕲 𝕳 𝕴 𝕵 𝕶 𝕷 𝕸 𝕹 𝕺 𝕻 𝕼 𝕽 𝕾 𝕿 𝖀 𝖁 𝖂 𝖃 𝖄 𝖅 𝖆 𝖇 𝖈 𝖉 𝖊 𝖋 𝖌 𝖍 𝖎 𝖏 𝖐 𝖑 𝖒 𝖓 𝖔 𝖕 𝖖 𝖗 𝖘 𝖙 𝖚 𝖛 𝖜 𝖝 𝖞 𝖟 𝟎 𝟏 𝟐 𝟑 𝟒 𝟓 𝟔 𝟕 𝟖 𝟗"
const string MAP_DOUBLE_STRUCK = "𝔸 𝔹 ℂ 𝔻 𝔼 𝔽 𝔾 ℍ 𝕀 𝕁 𝕂 𝕃 𝕄 ℕ 𝕆 ℙ ℚ ℝ 𝕊 𝕋 𝕌 𝕍 𝕎 𝕏 𝕐 ℤ 𝕒 𝕓 𝕔 𝕕 𝕖 𝕗 𝕘 𝕙 𝕚 𝕛 𝕜 𝕝 𝕞 𝕟 𝕠 𝕡 𝕢 𝕣 𝕤 𝕥 𝕦 𝕧 𝕨 𝕩 𝕪 𝕫 𝟘 𝟙 𝟚 𝟛 𝟜 𝟝 𝟞 𝟟 𝟠 𝟡"

// Other characters that also receive the underline or strikethrough (space is handled separately).
const string EXTRA_CHARS = "ąćęłńóśźżĄĆĘŁŃÓŚŹŻáàâäãåéèêëíìîïòôöõúùûüñçÁÀÂÄÃÅÉÈÊËÍÌÎÏÒÔÖÕÚÙÛÜÑÇ!#$%&()*+,-./:;<=>?@[]^_{|}~"
// Unicode combining marks: U+0332 (low line) and U+0336 (long stroke overlay).
const string UNDERLINE_MARK = "̲"
const string STRIKETHROUGH_MARK = "̶"

// ==================== INPUTS ====================
string groupMain = "Main text"
string groupSecond = "Second line"
string groupPosition = "Position"

string mainTextInput = input.string("IG: @nickname", "Text", group = groupMain, tooltip = "What to show on the chart. Emoji are supported.", display = display.none)
string mainFontInput = input.string(FONT_SYSTEM, "Font", options = [FONT_SYSTEM, FONT_MONO, FONT_SERIF, FONT_SERIF_ITALIC, FONT_SANS, FONT_SANS_ITALIC, FONT_SCRIPT, FONT_FRAKTUR, FONT_DOUBLE_STRUCK], group = groupMain, tooltip = "System uses the TradingView interface font of your device. Decorative styles are Unicode letters: they convert A–Z, a–z and 0–9, while accented letters, emoji and punctuation stay in the system font.", display = display.none)
bool mainBoldInput = input.bool(true, "Bold", inline = "mainFormat", group = groupMain, display = display.none)
bool mainItalicInput = input.bool(false, "Italic", inline = "mainFormat", group = groupMain, display = display.none)
string mainLineInput = input.string(LINE_NONE, "Line", options = [LINE_NONE, LINE_UNDERLINE, LINE_STRIKETHROUGH], group = groupMain, display = display.none)
int mainSizeInput = input.int(14, "Size (pt)", minval = 8, maxval = 120, inline = "mainLook", group = groupMain, display = display.none)
color mainColorInput = input.color(color.new(#434651, 25), "Color", inline = "mainLook", group = groupMain, tooltip = "Set transparency with the slider in the color picker.", display = display.none)

string secondTextInput = input.string("", "Text", group = groupSecond, tooltip = "Smaller text under the main line, e.g. TRADING | EDUCATION. Leave empty to hide.", display = display.none)
string secondFontInput = input.string(FONT_SYSTEM, "Font", options = [FONT_SYSTEM, FONT_MONO, FONT_SERIF, FONT_SERIF_ITALIC, FONT_SANS, FONT_SANS_ITALIC, FONT_SCRIPT, FONT_FRAKTUR, FONT_DOUBLE_STRUCK], group = groupSecond, display = display.none)
bool secondBoldInput = input.bool(false, "Bold", inline = "secondFormat", group = groupSecond, display = display.none)
bool secondItalicInput = input.bool(false, "Italic", inline = "secondFormat", group = groupSecond, display = display.none)
string secondLineInput = input.string(LINE_NONE, "Line", options = [LINE_NONE, LINE_UNDERLINE, LINE_STRIKETHROUGH], group = groupSecond, display = display.none)
int secondSizeInput = input.int(12, "Size (pt)", minval = 6, maxval = 60, inline = "secondLook", group = groupSecond, display = display.none)
color secondColorInput = input.color(color.new(#434651, 35), "Color", inline = "secondLook", group = groupSecond, display = display.none)

string positionInput = input.string(POS_TOP_RIGHT, "Location", options = [POS_TOP_CENTER, POS_TOP_LEFT, POS_TOP_RIGHT, POS_MIDDLE, POS_BOTTOM_CENTER, POS_BOTTOM_LEFT, POS_BOTTOM_RIGHT], group = groupPosition, display = display.none)
float offsetInput = input.float(7.0, "Edge offset (% of height)", minval = 0, maxval = 40, step = 0.5, group = groupPosition, tooltip = "Moves the text away from the top (or bottom) edge so the floating drawing toolbar does not cover it. Increase it if the text is still hidden.", display = display.none)

// ==================== FUNCTIONS ====================
styleMap(string font) =>
    switch font
        FONT_SERIF         => MAP_SERIF
        FONT_SERIF_ITALIC  => MAP_SERIF_ITALIC
        FONT_SANS          => MAP_SANS
        FONT_SANS_ITALIC   => MAP_SANS_ITALIC
        FONT_SCRIPT        => MAP_SCRIPT
        FONT_FRAKTUR       => MAP_FRAKTUR
        FONT_DOUBLE_STRUCK => MAP_DOUBLE_STRUCK
        => ""

// Converts letters and digits to the chosen Unicode style and appends the line mark after each character.
// The user's text is never split into characters, so emoji stay intact.
stylize(string source, string font, string lineStyle) =>
    string mark = lineStyle == LINE_UNDERLINE ? UNDERLINE_MARK : lineStyle == LINE_STRIKETHROUGH ? STRIKETHROUGH_MARK : ""
    string mapText = styleMap(font)
    bool restyle = mapText != ""
    array<string> charMap = restyle ? str.split(mapText, " ") : array.new<string>()
    string result = source
    if restyle or mark != ""
        for i = 0 to str.length(PLAIN_CHARS) - 1
            string plain = str.substring(PLAIN_CHARS, i, i + 1)
            result := str.replace_all(result, plain, (restyle ? charMap.get(i) : plain) + mark)
    if mark != ""
        for i = 0 to str.length(EXTRA_CHARS) - 1
            string extra = str.substring(EXTRA_CHARS, i, i + 1)
            result := str.replace_all(result, extra, extra + mark)
        result := str.replace_all(result, " ", " " + mark)
    result

fontFamily(string font) =>
    font == FONT_MONO ? font.family_monospace : font.family_default

textFormat(bool bold, bool italic) =>
    (bold ? text.format_bold : text.format_none) + (italic ? text.format_italic : text.format_none)

tablePosition(string choice) =>
    switch choice
        POS_TOP_LEFT      => position.top_left
        POS_TOP_RIGHT     => position.top_right
        POS_MIDDLE        => position.middle_center
        POS_BOTTOM_CENTER => position.bottom_center
        POS_BOTTOM_LEFT   => position.bottom_left
        POS_BOTTOM_RIGHT  => position.bottom_right
        => position.top_center

textAlign(string choice) =>
    switch choice
        POS_TOP_LEFT     => text.align_left
        POS_BOTTOM_LEFT  => text.align_left
        POS_TOP_RIGHT    => text.align_right
        POS_BOTTOM_RIGHT => text.align_right
        => text.align_center

// ==================== DRAWING ====================
bool atBottom = positionInput == POS_BOTTOM_CENTER or positionInput == POS_BOTTOM_LEFT or positionInput == POS_BOTTOM_RIGHT
bool useOffset = offsetInput > 0 and positionInput != POS_MIDDLE
bool hasMain = str.length(str.trim(mainTextInput)) > 0
bool hasSecond = str.length(str.trim(secondTextInput)) > 0

var table watermark = table.new(tablePosition(positionInput), 1, 3, frame_width = 0, border_width = 0)
var string mainText = stylize(mainTextInput, mainFontInput, mainLineInput)
var string secondText = stylize(secondTextInput, secondFontInput, secondLineInput)

if barstate.islast
    string align = textAlign(positionInput)
    int row = 0
    // An empty row with a fixed height pushes the text away from the edge (e.g. below the toolbar).
    if useOffset and not atBottom
        table.cell(watermark, 0, row, "", height = offsetInput)
        row += 1
    if hasMain
        table.cell(watermark, 0, row, mainText, text_color = mainColorInput, text_size = mainSizeInput, text_halign = align, text_font_family = fontFamily(mainFontInput), text_formatting = textFormat(mainBoldInput, mainItalicInput))
        row += 1
    if hasSecond
        table.cell(watermark, 0, row, secondText, text_color = secondColorInput, text_size = secondSizeInput, text_halign = align, text_font_family = fontFamily(secondFontInput), text_formatting = textFormat(secondBoldInput, secondItalicInput))
        row += 1
    if useOffset and atBottom
        table.cell(watermark, 0, row, "", height = offsetInput)
